        android:strokeLineJoin="round"
        android:pathData="M40.5,53 L42.2,54.8 L44.5,51" />
    <path
        android:fillColor="#FF007AFF"
        android:pathData="M50,51.5 L68,51.5 L68,54.5 L50,54.5 Z" />

    <!-- Baris checklist 2: kotak KOSONG (outline abu, belum dicentang) + garis teks lebih
