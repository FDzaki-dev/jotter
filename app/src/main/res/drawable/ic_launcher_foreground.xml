<!--
  Redesain total (v2_Batch50) - 2 masalah nyata dari laporan user:
  1. "icon sering keliatan truncated" - kartu versi lama (Batch49) terlalu besar, sudutnya
     nembus adaptive-icon "safe zone" (lingkaran radius 33dp dari tengah kanvas 108dp) -> kepotong
     di launcher yg pakai mask circle/squircle (bukan cuma rounded-square). Kartu baru ini
     SENGAJA diperkecil, SEMUA titik terluar dicek manual (script python, max jarak 27.78dp,
     masih 5dp+ margin dari batas 33dp) - dijamin gak kepotong di mask shape manapun.
  2. "gak paham ini app catatan, cuma garis-garis random" - ganti total dari 3 bar warna abstrak
     jadi notepad BENERAN (sudut kanan-atas dilipat/dog-ear, bahasa visual universal utk
     dokumen/catatan) + 2 baris CHECKLIST NYATA (1 kotak tercentang hijau + centang putih,
     1 kotak kosong outline abu) - checklist adalah metafora visual paling gampang dikenali
     sbg "app notes/todo", jauh lebih jelas drpd garis warna abstrak.
  Teknik: pindah dari layer-list (shape+gravity+inset, ambigu efeknya tanpa render tool) ke
  <vector> pathData koordinat absolut - deterministik, 0 tebak-tebakan posisi.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Kartu notepad putih: 3 sudut rounded (r=6) + 1 sudut dilipat (dog-ear) di kanan-atas -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,30 L64,30 L74,40 L74,72 Q74,78 68,78 L40,78 Q34,78 34,72 L34,36 Q34,30 40,30 Z" />

    <!-- Flap lipatan (abu muda) - kasih efek kertas terlipat di sudut yang dipotong -->
    <path
        android:fillColor="#FFD1D1D6"
        android:pathData="M64,30 L74,40 L64,40 Z" />

    <!-- Baris checklist 1: kotak TERCENTANG (hijau, salah satu dari 9 warna kategori resmi app)
         + tanda centang putih di dalamnya + garis teks di sampingnya -->
    <path
        android:fillColor="#FF34C759"
        android:pathData="M40.5,49.5 L44.5,49.5 Q46,49.5 46,51 L46,55 Q46,56.5 44.5,56.5 L40.5,56.5 Q39,56.5 39,55 L39,51 Q39,49.5 40.5,49.5 Z" />
