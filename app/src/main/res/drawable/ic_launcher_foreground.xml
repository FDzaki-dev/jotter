    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF8E8E93"
        android:strokeWidth="1.3"
        android:pathData="M40.5,62.5 L44.5,62.5 Q46,62.5 46,64 L46,68 Q46,69.5 44.5,69.5 L40.5,69.5 Q39,69.5 39,68 L39,64 Q39,62.5 40.5,62.5 Z" />
