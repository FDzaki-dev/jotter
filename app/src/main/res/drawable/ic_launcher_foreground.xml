<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="108dp" android:height="108dp">
        <shape android:shape="rectangle"><solid android:color="#00000000"/></shape>
    </item>
    <!-- Kartu catatan (note card) -->
    <item android:width="58dp" android:height="70dp" android:gravity="center">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF"/><corners android:radius="12dp"/></shape>
    </item>
    <!-- 3 baris teks, lebar menurun (meniru paragraf beneran, bukan 3 bar sama panjang) -
         warnanya PERSIS 3 dari 9 warna kategori asli app (Color.kt: Biru/Hijau/Oranye),
         nunjukin fitur pembeda utama Jotter (color-coding) langsung di icon-nya. -->
    <item android:width="36dp" android:height="5dp" android:gravity="center" android:top="24dp">
        <shape android:shape="rectangle"><solid android:color="#FF007AFF"/><corners android:radius="2.5dp"/></shape>
    </item>
    <item android:width="30dp" android:height="5dp" android:gravity="center" android:top="35dp">
        <shape android:shape="rectangle"><solid android:color="#FF34C759"/><corners android:radius="2.5dp"/></shape>
    </item>
    <item android:width="22dp" android:height="5dp" android:gravity="center" android:top="46dp">
        <shape android:shape="rectangle"><solid android:color="#FFFF9500"/><corners android:radius="2.5dp"/></shape>
    </item>
</layer-list>
